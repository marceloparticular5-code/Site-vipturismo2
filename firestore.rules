rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
             data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 256 &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024));
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['tourId', 'tourName', 'date', 'participants', 'totalAmount', 'status', 'voucherCode']) &&
             data.tourId is string && data.tourId.size() <= 64 &&
             data.tourName is string && data.tourName.size() <= 160 &&
             data.date is string && data.date.size() <= 32 &&
             data.participants is number && data.participants >= 1 && data.participants <= 100 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.status is string && (data.status in ['confirmed', 'pending', 'cancelled']) &&
             data.voucherCode is string && data.voucherCode.size() <= 64 &&
             (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
             (!('timeWindow' in data) || (data.timeWindow is string && data.timeWindow.size() <= 64)) &&
             (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 32)) &&
             (!('passengerName' in data) || (data.passengerName is string && data.passengerName.size() <= 120)) &&
             (!('passengerEmail' in data) || (data.passengerEmail is string && data.passengerEmail.size() <= 256)) &&
             (!('passengerPhone' in data) || (data.passengerPhone is string && data.passengerPhone.size() <= 32)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    function isValidLead(data) {
      return data.keys().hasAll(['name', 'phone', 'couponCode', 'status', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
             data.phone is string && data.phone.size() > 0 && data.phone.size() <= 32 &&
             data.couponCode is string && data.couponCode.size() <= 64 &&
             data.status is string && (data.status in ['new', 'contacted', 'booked']) &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             (!('tourInterest' in data) || (data.tourInterest is string && data.tourInterest.size() <= 160)) &&
             (!('travelMonth' in data) || (data.travelMonth is string && data.travelMonth.size() <= 64));
    }

    // Test connection endpoint
    match /test/{docId} {
      allow get: if true;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().uid == request.auth.uid;
      allow update: if isOwner(userId) && isValidUser(incoming()) && incoming().uid == existing().uid;
    }

    // Bookings Collection
    match /bookings/{bookingId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isValidBooking(incoming()) && (
        (isSignedIn() && incoming().userId == request.auth.uid) ||
        (!isSignedIn() && ('userId' in incoming()) && incoming().userId.size() > 0)
      );
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && isValidBooking(incoming()) && incoming().userId == existing().userId;
      allow delete: if false;
    }

    // Leads Collection
    match /leads/{leadId} {
      allow create: if isValidLead(incoming());
      allow get, list: if isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow update, delete: if false;
    }
  }
}

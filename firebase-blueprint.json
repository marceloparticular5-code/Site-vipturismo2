{
  "entities": {
    "Tour": {
      "title": "Tour",
      "description": "Passeio ou pacote turístico da Natal Vip Turismo",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "priceDiscounted": { "type": "number" },
        "description": { "type": "string", "maxLength": 5000 },
        "imageUrl": { "type": "string", "maxLength": 2048 },
        "galleryImages": { "type": "array" }
      },
      "required": ["id", "title", "priceDiscounted", "description", "imageUrl"]
    }
  },
  "firestore": {
    "/tours/{tourId}": {
      "schema": "Tour",
      "description": "Catálogo de passeios VIP gerenciados pela agência"
    }
  }
}

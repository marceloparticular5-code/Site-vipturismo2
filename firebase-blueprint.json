{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated user profile",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique user ID matching Firebase Auth uid",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "User email address",
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "description": "User display name",
          "maxLength": 120
        },
        "photoURL": {
          "type": "string",
          "description": "URL to user profile picture",
          "maxLength": 1024
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of account creation",
          "maxLength": 64
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "Booking": {
      "title": "Booking",
      "description": "VIP tour reservation made by an authenticated user or guest",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Booking document ID",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID or guest id",
          "maxLength": 128
        },
        "tourId": {
          "type": "string",
          "description": "ID of the booked tour",
          "maxLength": 64
        },
        "tourName": {
          "type": "string",
          "description": "Title of the tour",
          "maxLength": 160
        },
        "date": {
          "type": "string",
          "description": "Selected tour date",
          "maxLength": 32
        },
        "timeWindow": {
          "type": "string",
          "description": "Tide time window for tour departure",
          "maxLength": 64
        },
        "participants": {
          "type": "number",
          "description": "Number of booked passengers"
        },
        "totalAmount": {
          "type": "number",
          "description": "Total reservation price in BRL"
        },
        "paymentMethod": {
          "type": "string",
          "description": "Chosen payment method (pix, credit_card)",
          "maxLength": 32
        },
        "status": {
          "type": "string",
          "description": "Reservation status (confirmed, pending, cancelled)",
          "maxLength": 32
        },
        "voucherCode": {
          "type": "string",
          "description": "Unique VIP voucher code",
          "maxLength": 64
        },
        "passengerName": {
          "type": "string",
          "description": "Primary passenger contact name",
          "maxLength": 120
        },
        "passengerEmail": {
          "type": "string",
          "description": "Primary passenger email",
          "maxLength": 256
        },
        "passengerPhone": {
          "type": "string",
          "description": "Primary passenger phone number",
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp",
          "maxLength": 64
        }
      },
      "required": ["tourId", "tourName", "date", "participants", "totalAmount", "status", "voucherCode"]
    },
    "Lead": {
      "title": "Lead",
      "description": "Prospective tourist lead captured via VIP discount coupon or concierge",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Lead document ID",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Lead name",
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "description": "Contact phone or WhatsApp",
          "maxLength": 32
        },
        "tourInterest": {
          "type": "string",
          "description": "Tour of interest",
          "maxLength": 160
        },
        "travelMonth": {
          "type": "string",
          "description": "Month of travel",
          "maxLength": 64
        },
        "couponCode": {
          "type": "string",
          "description": "Activated discount coupon code",
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "description": "Lead status (new, contacted, booked)",
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when lead was created",
          "maxLength": 64
        }
      },
      "required": ["name", "phone", "couponCode", "status", "createdAt"]
    },
    "Tour": {
      "title": "Tour",
      "description": "Tour package offered by the agency and managed via Admin panel",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Tour unique ID slug",
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "description": "Main title of the tour",
          "maxLength": 160
        },
        "subtitle": {
          "type": "string",
          "description": "Engaging subtitle or USP",
          "maxLength": 250
        },
        "badge": {
          "type": "string",
          "description": "Promotional badge text",
          "maxLength": 64
        },
        "location": {
          "type": "string",
          "description": "Tour location and departure zone",
          "maxLength": 120
        },
        "rating": {
          "type": "number",
          "description": "Tour rating from 1 to 5"
        },
        "reviewsCount": {
          "type": "number",
          "description": "Total count of reviews"
        },
        "priceOriginal": {
          "type": "number",
          "description": "Original retail price"
        },
        "priceDiscounted": {
          "type": "number",
          "description": "Current promotional price"
        },
        "duration": {
          "type": "string",
          "description": "Duration text",
          "maxLength": 64
        },
        "includesDiving": {
          "type": "boolean",
          "description": "Whether tour includes diving"
        },
        "isVip": {
          "type": "boolean",
          "description": "Whether tour is exclusive VIP"
        },
        "urgencyText": {
          "type": "string",
          "description": "Urgency banner or tide advisory",
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "description": "Detailed description of the tour",
          "maxLength": 2000
        },
        "imageUrl": {
          "type": "string",
          "description": "Cover photo URL of the tour",
          "maxLength": 1024
        },
        "active": {
          "type": "boolean",
          "description": "Whether the tour is active and visible on the website"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update ISO timestamp",
          "maxLength": 64
        }
      },
      "required": ["id", "title", "priceDiscounted", "description", "imageUrl"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Authenticated user profile records"
    },
    "/bookings/{bookingId}": {
      "schema": {
        "$ref": "#/entities/Booking"
      },
      "description": "Customer tour reservations and VIP vouchers"
    },
    "/leads/{leadId}": {
      "schema": {
        "$ref": "#/entities/Lead"
      },
      "description": "VIP Concierge leads and promotional coupons"
    },
    "/tours/{tourId}": {
      "schema": {
        "$ref": "#/entities/Tour"
      },
      "description": "Registered tours managed by administrators"
    },
    "/admins/{adminId}": {
      "schema": {
        "title": "Admin",
        "description": "Administrator permission record",
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 256
          },
          "role": {
            "type": "string",
            "maxLength": 32
          }
        },
        "required": ["email", "role"]
      },
      "description": "List of system administrators"
    }
  }
}
